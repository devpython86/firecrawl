{
  "name": "firecrawl",
  "image": "mcr.microsoft.com/devcontainers/base:jammy",
  "privileged": true,

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    }
  },

  "forwardPorts": [3663],
  "portsAttributes": {
    "3663": {
      "label": "Firecrawl API",
      "onAutoForward": "silent"
    }
  },

  "postStartCommand": "bash setup.sh"
}
