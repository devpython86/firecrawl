{
  "name": "firecrawl",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "privileged": true,

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  "forwardPorts": [3663],
  "portsAttributes": {
    "3663": {
      "label": "Firecrawl API",
      "onAutoForward": "silent"
    }
  },

  "postStartCommand": "bash setup.sh"
}
